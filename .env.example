# Server Port
PORT=5000
NODE_ENV=development

# Origin Frontend (Next.js / Flutter Web)
CORS_ORIGIN=http://localhost:3000

# Rahasia Penandatangan Token Sesi
SESSION_SECRET=sriwedari-keraton-surakarta-secret-2026-production-grade

# Pilihan Database Driver: 'json' (default tanpa XAMPP) atau 'mysql' (MySQL Cloud / XAMPP)
DB_DRIVER=json

# Jika DB_DRIVER=mysql, isi salah satu: DATABASE_URL (Cloud MySQL) ATAU DB_HOST..DB_NAME (Lokal/XAMPP)
# DATABASE_URL="mysql://root:@localhost:3306/sriwedari_db"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sriwedari_db

# Rate Limit Config
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
